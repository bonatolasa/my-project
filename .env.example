# Local development defaults. Replace secrets before any shared or production deployment.
NODE_ENV=development
APP_NAME=Virtual Phone Platform
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Local compose credentials. Change before exposing services outside your machine.
POSTGRES_USER=virtual_phone
POSTGRES_PASSWORD=local_dev_change_me
POSTGRES_DB=virtual_phone
DATABASE_URL=postgresql://virtual_phone:local_dev_change_me@localhost:5432/virtual_phone?schema=public
REDIS_URL=redis://localhost:6379

# Generate a random value for local development; production should use a secret manager.
JWT_ACCESS_SECRET=replace_with_at_least_32_random_bytes
JWT_ACCESS_TTL=10m
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Optional Google OAuth. Add the callback URL below to Google's Authorized redirect URIs.
# Local default is http://localhost:3000/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional future integrations. Keep empty until configured; never put these in frontend env.
TELECOM_PROVIDER=mock
TELECOM_ACCOUNT_ID=
TELECOM_AUTH_TOKEN=
TELECOM_WEBHOOK_SECRET=
SMS_MODE=test
OTP_TTL_SECONDS=300
OTP_PEPPER=replace_with_a_random_secret_for_otp_hashing
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=Virtual Phone Platform <noreply@example.com>
